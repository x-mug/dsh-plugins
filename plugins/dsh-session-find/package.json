{
  "name": "@x-mug/dsh-session-find",
  "version": "1.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/x-mug/dsh-plugins.git",
    "directory": "plugins/dsh-session-find"
  },
  "type": "module",
  "description": "Worker-powered search with verified history, exact navigation checks and cross-session search.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "PERFORMANCE.md", "src/*.js", "src/*.css", "build.mjs", "test/*.mjs"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-shortcuts", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
